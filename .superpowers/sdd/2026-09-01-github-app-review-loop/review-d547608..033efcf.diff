+    @Bean
+    ReviewWorkspaceJanitorScheduler reviewWorkspaceJanitorScheduler(
+            ReviewWorkspaceJanitor janitor) {
+        return new ReviewWorkspaceJanitorScheduler(janitor);
+    }
+}
